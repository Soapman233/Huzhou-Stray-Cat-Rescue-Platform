<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzsca.mapper.MatchWeightMapper">
    <resultMap id="BaseResultMap" type="com.hzsca.entity.MatchWeight">
        <id column="weight_key" property="weightKey"/>
        <result column="weight_value" property="weightValue"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT weight_key, weight_value
        FROM match_weights
    </select>
</mapper>
