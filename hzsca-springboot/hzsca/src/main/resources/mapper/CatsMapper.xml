<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzsca.mapper.CatsMapper">
    <select id="getAllCats" resultType="com.hzsca.entity.Cats">
        SELECT * FROM animals
    </select>
    <select id="getCatById" parameterType="int" resultType="com.hzsca.entity.Cats">
        SELECT * FROM animals WHERE animalId = #{id}
    </select>
</mapper>