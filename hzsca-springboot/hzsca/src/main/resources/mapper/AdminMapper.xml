<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzsca.mapper.AdminMapper">
    <resultMap id="BaseResultMap" type="com.hzsca.entity.Admin">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="role" property="role" jdbcType="VARCHAR"/>
        <result column="avatar" property="avatar" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="selectByUsername" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT * FROM admins WHERE username = #{username}
    </select>

    <select id="selectById" resultMap="BaseResultMap" parameterType="java.lang.Integer">
        SELECT * FROM admins WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.hzsca.entity.Admin" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admins (username, password, name, role, avatar)
        VALUES (#{username}, #{password}, #{name}, #{role}, #{avatar})
    </insert>

    <update id="update" parameterType="com.hzsca.entity.Admin">
        UPDATE admins
        SET username = #{username},
            password = #{password},
            name = #{name},
            role = #{role},
            avatar = #{avatar}
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE admins
        SET password = #{password}
        WHERE id = #{id}
    </update>

    <update id="updateProfile" parameterType="com.hzsca.entity.Admin">
        UPDATE admins
        SET name = #{name},
            avatar = #{avatar}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM admins WHERE id = #{id}
    </delete>
</mapper>