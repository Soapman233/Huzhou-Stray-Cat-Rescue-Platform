<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzsca.mapper.CatsMapper">
    <!-- 结果映射 -->
    <resultMap id="CatResultMap" type="com.hzsca.entity.Animals">
        <!-- Animals 属性 -->
        <id column="AnimalID" property="animalId"/>
        <result column="Name" property="name"/>
        <result column="Species" property="species"/>
        <result column="Breed" property="breed"/>
        <result column="Age" property="age"/>
        <result column="Gender" property="gender"/>
        <result column="HealthStatus" property="healthStatus"/>
        <result column="Description" property="description"/>
        <result column="ImageURL" property="imageUrl"/>
        <result column="Source" property="source"/>
    </resultMap>

    <select id="getAllCats" resultMap="CatResultMap">
        SELECT
            AnimalID,
            Name,
            Species,
            Breed,
            Age,
            Gender,
            HealthStatus,
            Description,
            ImageURL,
            Source
        FROM Animals
        WHERE Species = '猫'
    </select>

    <select id="getCatById" parameterType="int" resultMap="CatResultMap">
        SELECT
            AnimalID,
            Name,
            Species,
            Breed,
            Age,
            Gender,
            HealthStatus,
            Description,
            ImageURL,
            Source
        FROM Animals
        WHERE AnimalID = #{id} AND Species = '猫'
    </select>
</mapper>