page {
  background: #f5f5f5;
  color: #333333;
  font-size: 28rpx;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.primary-btn {
  background: #333333;
  color: #ffffff;
}

.ghost-btn {
  background: #ffffff;
  color: #333333;
  border: 2rpx solid #333333;
}
