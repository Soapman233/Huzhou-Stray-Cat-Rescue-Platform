.profile-card {
  background: #E6DCC8;
}

.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  font-size: 34rpx;
  font-weight: 800;
  color: #333333;
}

.info {
  flex: 1;
}

.name {
  font-size: 32rpx;
  font-weight: 800;
  color: #111827;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #334155;
}

.menu {
  display: flex;
  flex-direction: column;
}

.item {
  padding: 18rpx 10rpx;
  border-bottom: 2rpx solid #f0f0f0;
  color: #111827;
}

.item:last-child {
  border-bottom: none;
}

.danger-btn {
  background: #b91c1c;
  color: #ffffff;
}
