.cat-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cat-image {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: #eeeeee;
}

.cat-name {
  font-size: 32rpx;
  font-weight: 600;
}

.cat-desc {
  color: #666666;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.top-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.header-card {
  background: #E6DCC8;
}
