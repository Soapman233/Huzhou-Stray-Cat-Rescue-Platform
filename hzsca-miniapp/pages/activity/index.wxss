.hero {
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 24rpx;
  background: #E6DCC8;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  color: #333333;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.hero-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.v-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.10);
  color: #111827;
  font-size: 24rpx;
  font-weight: 800;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f1f1;
  color: #334155;
  font-size: 24rpx;
}

.chip-active {
  background: #333333;
  color: #ffffff;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search {
  flex: 1;
  background: #f7f7f7;
  border-radius: 14rpx;
  padding: 16rpx 14rpx;
}

.hint {
  text-align: center;
  padding: 18rpx 0;
  color: #64748b;
}

.activity-card {
  border-left: 10rpx solid #333333;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
}

.a-title {
  font-weight: 800;
  font-size: 30rpx;
  color: #111827;
}

.badge {
  font-size: 22rpx;
  color: #111827;
  background: #E6DCC8;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.meta {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
}

.detail {
  margin-top: 10rpx;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.6;
}
