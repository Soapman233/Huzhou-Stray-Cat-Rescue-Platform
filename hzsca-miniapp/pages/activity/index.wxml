<view class="page">
  <view class="hero">
    <view class="title">协会活动</view>
    <view class="sub">最新活动动态与回顾</view>
    <view class="hero-actions">
      <button wx:if="{{!isLoggedIn}}" size="mini" bindtap="goLogin">登录</button>
      <button wx:if="{{isLoggedIn && !isVolunteer}}" size="mini" class="primary-btn" bindtap="goVolunteerApply">成为志愿者</button>
      <view wx:if="{{isLoggedIn && isVolunteer}}" class="v-tag">志愿者</view>
    </view>
  </view>

  <view class="card">
    <view class="filters">
      <view class="chip {{filter==='ALL' ? 'chip-active' : ''}}" bindtap="setFilter" data-filter="ALL">全部</view>
      <view class="chip {{filter==='ongoing' ? 'chip-active' : ''}}" bindtap="setFilter" data-filter="ongoing">进行中</view>
      <view class="chip {{filter==='upcoming' ? 'chip-active' : ''}}" bindtap="setFilter" data-filter="upcoming">即将开始</view>
      <view class="chip {{filter==='ended' ? 'chip-active' : ''}}" bindtap="setFilter" data-filter="ended">回顾</view>
    </view>
    <view class="search-row">
      <input class="search" placeholder="搜索标题/地点" value="{{keyword}}" bindinput="onKeyword" />
      <button size="mini" bindtap="reload">刷新</button>
    </view>
  </view>

  <view class="card" wx:if="{{loading}}">
    <view class="hint">加载中...</view>
  </view>

  <view class="card" wx:if="{{!loading && list.length===0}}">
    <view class="hint">暂无活动</view>
  </view>

  <view class="card activity-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="row">
      <view class="a-title">{{item.title}}</view>
      <view class="badge">{{item.status}}</view>
    </view>
    <view class="meta">{{item.date}} · {{item.Location || item.location}}</view>
    <view class="detail">{{item.detail}}</view>
  </view>
</view>
