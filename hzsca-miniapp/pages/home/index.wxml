<view class="page">
  <view class="hero">
    <view class="brand">HZSCA</view>
    <view class="slogan">湖州拯救流浪猫协会 · 让每只猫都有家</view>
    <view class="hero-actions">
      <button class="primary-btn" size="mini" bindtap="goRecommend">智能推荐</button>
      <button class="ghost-btn" size="mini" bindtap="goCats">去领养</button>
    </view>
  </view>

  <view class="card">
    <view class="section-title">快捷入口</view>
    <view class="grid">
      <view class="grid-item" bindtap="goProfile">
        <view class="grid-title">领养档案</view>
        <view class="grid-sub">完善条件</view>
      </view>
      <view class="grid-item" bindtap="goApplications">
        <view class="grid-title">我的申请</view>
        <view class="grid-sub">进度查询</view>
      </view>
      <view class="grid-item" bindtap="goRescueReport">
        <view class="grid-title">救助上报</view>
        <view class="grid-sub">发现求助</view>
      </view>
      <view class="grid-item" bindtap="goActivity">
        <view class="grid-title">活动</view>
        <view class="grid-sub">最新动态</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">热门待领养</view>
    <view class="cat-grid">
      <view class="cat-item" wx:for="{{cats}}" wx:key="AnimalID" bindtap="goDetail" data-id="{{item.AnimalID}}">
        <image class="cat-img" src="{{baseImageUrl}}{{item.ImageURL}}" mode="aspectFill"></image>
        <view class="cat-name">{{item.Name}}</view>
        <view class="cat-sub">{{item.Breed}} · {{item.Age}}岁</view>
      </view>
    </view>
    <button class="ghost-btn" bindtap="goCats">查看更多</button>
  </view>

  <view class="card">
    <view class="section-title">养猫须知</view>
    <view class="tips">
      <view class="tip">领养前请确认家人同意，并评估长期投入</view>
      <view class="tip">猫咪需要稳定饮食、疫苗、驱虫与医疗储备</view>
      <view class="tip">室内饲养更安全，建议安装纱窗与防护</view>
      <view class="tip">定期绝育、体检，降低疾病与走失风险</view>
    </view>
    <view class="more-links">
      <button size="mini" bindtap="goDonate">捐助我们</button>
      <button size="mini" bindtap="goWorkReport">工作报告</button>
    </view>
  </view>
</view>
