<view class="page">
  <view class="card header">
    <view class="title">成为志愿者</view>
    <view class="sub">提交申请后由管理员审核，通过后可预约参加活动</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">姓名*</view>
      <input class="input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onInput" data-key="name" />
    </view>
    <view class="field">
      <view class="label">手机号</view>
      <input class="input" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onInput" data-key="phone" />
    </view>
    <view class="field">
      <view class="label">年龄</view>
      <input class="input" type="number" placeholder="例如：20" value="{{form.age}}" bindinput="onInput" data-key="age" />
    </view>
    <view class="field">
      <view class="label">爱心经历</view>
      <textarea class="textarea" placeholder="例如：参与投喂/救助/回访等" value="{{form.experience}}" bindinput="onInput" data-key="experience" />
    </view>
    <view class="field">
      <view class="label">申请原因</view>
      <textarea class="textarea" placeholder="你想成为志愿者的原因" value="{{form.motivation}}" bindinput="onInput" data-key="motivation" />
    </view>
    <button class="primary-btn" bindtap="submit" loading="{{loading}}">提交申请</button>
  </view>
</view>
