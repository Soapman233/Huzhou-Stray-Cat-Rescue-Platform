<view class="page">
  <view class="card header">
    <view class="title">个人信息</view>
    <view class="sub">用于完善展示与匹配推荐</view>
  </view>

  <view class="card">
    <view class="section-title">基础资料</view>
    <view class="field">
      <view class="label">昵称</view>
      <input class="input" placeholder="请输入昵称" value="{{form.nickname}}" bindinput="onInput" data-key="nickname" />
    </view>
    <view class="field">
      <view class="label">头像URL</view>
      <input class="input" placeholder="http(s)://..." value="{{form.avatar}}" bindinput="onInput" data-key="avatar" />
    </view>
    <view class="field">
      <view class="label">城市</view>
      <input class="input" placeholder="例如：湖州" value="{{form.city}}" bindinput="onInput" data-key="city" />
    </view>
    <view class="field">
      <view class="label">省份</view>
      <input class="input" placeholder="例如：浙江" value="{{form.province}}" bindinput="onInput" data-key="province" />
    </view>
    <view class="field">
      <view class="label">国家</view>
      <input class="input" placeholder="例如：中国" value="{{form.country}}" bindinput="onInput" data-key="country" />
    </view>
  </view>

  <view class="footer">
    <button class="primary-btn" bindtap="save" loading="{{saving}}">保存</button>
  </view>
</view>
