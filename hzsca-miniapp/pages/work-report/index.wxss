.hero {
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 24rpx;
  background: #E6DCC8;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 34rpx;
  font-weight: 800;
  color: #333333;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
}

.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat {
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 18rpx 14rpx;
}

.num {
  font-size: 34rpx;
  font-weight: 800;
  color: #111827;
}

.label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.table {
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid #eeeeee;
}

.tr {
  display: flex;
}

.head {
  background: #f7f7f7;
}

.td {
  flex: 1;
  padding: 12rpx 10rpx;
  font-size: 24rpx;
  color: #334155;
  border-bottom: 2rpx solid #eeeeee;
  border-right: 2rpx solid #eeeeee;
  text-align: center;
}

.month {
  flex: 1.1;
}

.p {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.7;
}

.hl {
  color: #111827;
  font-weight: 800;
}
