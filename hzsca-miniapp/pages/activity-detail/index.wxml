<view class="page">
  <view class="card header">
    <view class="title">{{activity.title || '活动'}}</view>
    <view class="meta">{{activity.date}} · {{activity.location || activity.Location}}</view>
    <view class="meta">状态：{{activity.status}}</view>
  </view>

  <view class="card" wx:if="{{activity.imgurl}}">
    <image class="img" src="{{baseImageUrl}}{{activity.imgurl}}" mode="aspectFill"></image>
  </view>

  <view class="card">
    <view class="section-title">活动内容</view>
    <view class="detail">{{activity.detail}}</view>
  </view>

  <view class="footer">
    <button class="ghost-btn" bindtap="goBack">返回</button>
    <button wx:if="{{isVolunteer && activity.status !== 'ended'}}" class="primary-btn" bindtap="join">预约参加</button>
  </view>
</view>
