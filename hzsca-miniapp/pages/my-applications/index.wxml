<view class="page">
  <view class="card header-card">
    <view class="section-title">我的领养申请</view>
    <button size="mini" bindtap="fetchList">刷新</button>
  </view>
  <view class="card" wx:for="{{list}}" wx:key="requestId">
    <view class="section-title">{{item.animalName || '未命名猫咪'}}</view>
    <view class="line">申请编号：{{item.requestId}}</view>
    <view class="line">申请状态：{{item.status}}</view>
    <view class="line">风险等级：{{item.riskLevel || '未计算'}}</view>
    <view class="line">申请时间：{{item.applyTime}}</view>
  </view>
</view>
