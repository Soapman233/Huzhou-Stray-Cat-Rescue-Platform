.hero {
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 24rpx;
  background: #E6DCC8;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  color: #333333;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.p {
  color: #334155;
  font-size: 26rpx;
  line-height: 1.7;
}

.list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.li {
  background: #f7f7f7;
  border-radius: 14rpx;
  padding: 12rpx 14rpx;
  color: #334155;
  font-size: 24rpx;
}

.tag {
  margin-top: 10rpx;
  background: #f7f7f7;
  border-radius: 999rpx;
  padding: 10rpx 14rpx;
  display: inline-block;
  color: #334155;
  font-size: 24rpx;
}

.contact {
  margin-top: 10rpx;
  color: #334155;
  font-size: 26rpx;
}
