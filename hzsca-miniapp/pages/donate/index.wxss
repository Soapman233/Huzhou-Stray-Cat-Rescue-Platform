.hero {
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 24rpx;
  background: #E6DCC8;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  color: #333333;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.p {
  color: #334155;
  font-size: 26rpx;
  line-height: 1.7;
}

.list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.li {
  background: #f7f7f7;
  border-radius: 14rpx;
  padding: 12rpx 14rpx;
  color: #334155;
  font-size: 24rpx;
}

.tag {
  margin-top: 10rpx;
  background: #f7f7f7;
  border-radius: 999rpx;
  padding: 10rpx 14rpx;
  display: inline-block;
  color: #334155;
  font-size: 24rpx;
}

.contact {
  margin-top: 10rpx;
  color: #334155;
  font-size: 26rpx;
}

/* ============ 捐助卡片 ============ */
.donate-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.mock-badge {
  background: #FFF4E0;
  color: #B26A00;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid #F0D3A8;
}

.mock-alert {
  background: #FFF9EC;
  border: 2rpx solid #F5E3C0;
  border-radius: 14rpx;
  padding: 16rpx;
  font-size: 24rpx;
  color: #8a6420;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.stat-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FDF6EC;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 24rpx;
}

.stat-label {
  font-size: 25rpx;
  color: #6d4c41;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #d97706;
}

.amount-label {
  font-size: 27rpx;
  font-weight: 600;
  color: #5d4037;
  margin-bottom: 16rpx;
}

.amount-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.amount-chip {
  min-width: 120rpx;
  text-align: center;
  padding: 18rpx 24rpx;
  border: 2rpx solid #e0d6c8;
  background: #ffffff;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #5d4037;
}

.amount-chip.active {
  border-color: #d97706;
  background: #FDF3E3;
  color: #b45309;
  font-weight: 700;
}

.custom-amount {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.custom-input {
  flex: 1;
  border: 2rpx solid #e0d6c8;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  background: #ffffff;
}

.unit {
  font-size: 26rpx;
  color: #78909c;
}

.remark-input {
  border: 2rpx solid #e0d6c8;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  background: #ffffff;
  margin-bottom: 14rpx;
}

.tip-line {
  font-size: 22rpx;
  color: #9e9e9e;
  margin-bottom: 24rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #f0a44b, #d97706);
  color: #ffffff;
  text-align: center;
  border-radius: 14rpx;
  padding: 26rpx;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}

.ghost-btn {
  background: #ffffff;
  color: #b45309;
  border: 2rpx solid #d97706;
  text-align: center;
  border-radius: 14rpx;
  padding: 22rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.safe-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9e9e9e;
}

/* ============ 订单信息 ============ */
.status-banner {
  border-radius: 14rpx;
  padding: 20rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.status-banner.pending {
  background: #FFF4E0;
}

.status-banner.success {
  background: #E8F5E9;
}

.status-banner.closed {
  background: #FDECEC;
}

.status-text {
  font-size: 30rpx;
  font-weight: 700;
}

.status-banner.pending .status-text {
  color: #B26A00;
}

.status-banner.success .status-text {
  color: #2E7D32;
}

.status-banner.closed .status-text {
  color: #C62828;
}

.order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx dashed #f0f0f0;
  font-size: 26rpx;
  color: #6d5a4a;
}

.order-value {
  color: #5d4037;
  max-width: 60%;
  text-align: right;
}

.order-value.mono {
  font-size: 22rpx;
  color: #8d7b6a;
}

.order-value.amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #d97706;
}
