.header-card {
  background: #E6DCC8;
  color: #333333;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.form-item {
  margin-top: 18rpx;
}

.label {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.input {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 16rpx;
}

.radio-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer {
  padding: 24rpx;
}
