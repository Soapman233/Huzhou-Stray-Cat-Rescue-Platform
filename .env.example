# ============================================================
# HZSCA 环境变量示例
# ------------------------------------------------------------
# 用法：复制为 .env 并按需修改，然后：
#   Windows(bash):  set -a && source .env && set +a
#   Linux/macOS:    export $(grep -v '^#' .env | xargs)
# 再启动后端 ./mvnw spring-boot:run
#
# 注意：.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库。
# ============================================================

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hzsca
DB_USERNAME=root
DB_PASSWORD=1234

# ---------- JWT ----------
# 必须至少 32 字节，否则后端启动时会直接报错
JWT_SECRET=请替换为不少于32字节的随机字符串_ChangeMe_0123456789abcdef

# ---------- 微信小程序 ----------
WECHAT_APPID=
WECHAT_SECRET=

# ---------- 支付宝沙箱（留空则自动降级为 Mock 演示模式）----------
ALIPAY_ENABLED=false
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
# 商户应用私钥（PKCS#8，Base64，可含 PEM 头尾或换行）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（用于异步通知验签）
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:8080/api/payment/alipay/notify
ALIPAY_RETURN_URL=http://localhost:5173/hzsca/donate/result
